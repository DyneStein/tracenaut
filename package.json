{
  "name": "tracenaut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Start from the running application, follow the code behind it.",
  "workspaces": [
    "packages/*",
    "examples/taskboard"
  ],
  "scripts": {
    "build": "npm run assets && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "daemon": "node packages/daemon/dist/cli.js start examples/taskboard",
    "demo:web": "npm run dev:web -w examples/taskboard",
    "demo:api": "npm run dev:api -w examples/taskboard",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "assets": "node scripts/icons/build-icons.mjs && node scripts/icons/gallery.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "7.27.0",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.15"
  }
}
